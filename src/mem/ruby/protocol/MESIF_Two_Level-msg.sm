// CoherenceRequestType
enumeration(CoherenceRequestType, desc="...") {
  GETX,      desc="Get eXclusive";
  UPGRADE,   desc="UPGRADE to exclusive";
  GETS,      desc="Get Shared";
  GET_INSTR, desc="Get Instruction";
  INV,       desc="INValidate";
  PUTX,      desc="Replacement message";
  WB_ACK,    desc="Writeback ack";
  DMA_READ,  desc="DMA Read";
  DMA_WRITE, desc="DMA Write";
  FLUSH,     desc="Flush request";
  FLUSH_NP,  desc="Flush request (not present in L1 and L0)";
  FLUSH_DATA,desc="Get data for flush request";
}

// CoherenceResponseType
enumeration(CoherenceResponseType, desc="...") {
  MEMORY_ACK, desc="Ack from memory controller";
  DATA, desc="Data block for L1 cache in S state";
  DATA_EXCLUSIVE, desc="Data block for L1 cache in M/E state";
  DATA_FORWARD,   desc="Data block for L1 cache in F state (forward owner)"; // MESIF
  MEMORY_DATA, desc="Data block from / to main memory";
  ACK, desc="Generic invalidate ack";
  WB_ACK, desc="writeback ack";
  UNBLOCK, desc="unblock";
  EXCLUSIVE_UNBLOCK, desc="exclusive unblock";
  INV, desc="Invalidate from directory";
  FLUSH_ACK, desc="Flush ack";
}

// RequestMsg
structure(RequestMsg, desc="...", interface="Message") {
  Addr addr;
  CoherenceRequestType Type;
  RubyAccessMode AccessMode;
  MachineID Requestor;
  NetDest Destination;
  MessageSizeType MessageSize;
  DataBlock DataBlk;
  int Len;
  bool Dirty, default="false";
  PrefetchBit Prefetch;

  bool functionalRead(Packet *pkt) {
    if (Type == CoherenceRequestType:PUTX) {
      return testAndRead(addr, DataBlk, pkt);
    }
    return false;
  }

  bool functionalWrite(Packet *pkt) {
    return testAndWrite(addr, DataBlk, pkt);
  }
}

// ResponseMsg
structure(ResponseMsg, desc="...", interface="Message") {
  Addr addr;
  CoherenceResponseType Type;
  MachineID Sender;
  NetDest Destination;
  DataBlock DataBlk;
  bool Dirty, default="false";
  int AckCount, default="0";
  MessageSizeType MessageSize;

  bool functionalRead(Packet *pkt) {
    if (Type == CoherenceResponseType:DATA ||
        Type == CoherenceResponseType:DATA_EXCLUSIVE ||
        Type == CoherenceResponseType:DATA_FORWARD ||
        Type == CoherenceResponseType:MEMORY_DATA) {
      return testAndRead(addr, DataBlk, pkt);
    }
    return false;
  }

  bool functionalWrite(Packet *pkt) {
    return testAndWrite(addr, DataBlk, pkt);
  }
}
