```gitignore
# Compiled and binary files
*.pyc
__pycache__/

# Dependencies
venv/
.venv/
node_modules/

# Editors/IDE
.vscode/
.idea/
*.swp
*.swo

# Logs and temp files
*.log
*.tmp

# System files
.DS_Store
Thumbs.db

# Coverage reports
coverage/
htmlcov/
.coverage

# Build artifacts
build/
dist/
target/
.mypy_cache/
.pytest_cache/
.gradle/
```